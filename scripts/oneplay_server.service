[Unit]
Description=Oneplay Server
After=network.target

[Service]
Type=simple
Restart=on-failure
User=hts
Group=video
WorkingDirectory=/usr/src/oneplay/script.oneplay.server
ExecStart=/usr/src/oneplay/venv/bin/python /usr/src/oneplay/script.oneplay.server/server.py
# Nepoužívat ExecStartPre s rm session.txt/channels.txt – po restartu způsobí cold login a zátěž API.
# Session reset: webové rozhraní (Session reset) nebo ručně smazat data/session.txt.

[Install]
WantedBy=multi-user.target
